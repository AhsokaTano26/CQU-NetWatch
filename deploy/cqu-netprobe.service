[Unit]
Description=CQU NetProbe read-only network dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netprobe
Group=netprobe
WorkingDirectory=/opt/cqu-netprobe
EnvironmentFile=/etc/cqu-netprobe.env
ExecStart=/usr/bin/node /opt/cqu-netprobe/server/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
