{
  "name": "cqu-netprobe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build"
  },
  "dependencies": { "vue": "^3.5.0", "vue-router": "^4.5.0", "uplot": "^1.6.32" },
  "devDependencies": { "@vitejs/plugin-vue": "^6.0.0", "typescript": "^5.9.0", "vite": "^7.0.0", "vue-tsc": "^3.0.0" }
}
